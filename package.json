{
  "name": "portfolio-site",
  "version": "1.0.0",
  "description": "Personal portfolio site for Charles Conner.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/fetch-contributions.mjs && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{js,jsx}\"",
    "types:worker": "wrangler types",
    "check:worker": "tsc --project tsconfig.worker.json",
    "deploy:cloudflare:dry": "npm run build && wrangler deploy --dry-run",
    "deploy:cloudflare": "npm run build && wrangler deploy",
    "og": "node scripts/render-og.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charliec2004/portfolio-site.git"
  },
  "keywords": [],
  "author": "Charles Conner",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/charliec2004/portfolio-site/issues"
  },
  "homepage": "https://github.com/charliec2004/portfolio-site#readme",
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260727.1",
    "@eslint/js": "^9.39.2",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-react": "^5.1.3",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.0.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^7.0.2",
    "vite": "^7.3.1",
    "wrangler": "^4.114.0"
  }
}
